# TEMPLATE ONLY: never commit the completed file or a real secret.
# The app does not auto-load this file. Supply variables via your shell/deployer.
SPASHINY_WEB_PLATFORM=1
SPASHINY_DEPLOYMENT_MODE=web
SPASHINY_WORKSPACE=/srv/spashiny/workspace
SPASHINY_STORAGE_BACKEND=local
SPASHINY_LOCAL_DATA_ROOT=/srv/spashiny/data
SPASHINY_LOCAL_OBJECT_ROOT=/srv/spashiny/data/sessions
SPASHINY_COMPUTE_PROVIDER_MODE=fake
SPASHINY_R2_ENABLED=0
SPASHINY_REMOTE_PROVIDER_ENABLED=0
SPASHINY_SESSION_HMAC_SECRET=REPLACE_WITH_A_NEW_PRIVATE_RANDOM_SECRET
SPASHINY_R_FEATURES_ENABLED=0
SPASHINY_CPU_ENRICHMENT_ENABLED=1
SPASHINY_ENABLE_EMBEDDED_DASH=0
# Example local trial timeouts; these are NOT exported live configuration.
SESSION_IDLE_TIMEOUT_SECONDS=43200
SESSION_HEARTBEAT_INTERVAL_SECONDS=30
SPASHINY_ANALYSIS_HEARTBEAT_LEASE_SECONDS=300
SPASHINY_ANALYSIS_CLOSE_GRACE_SECONDS=30
# Real workers, auth, database, example assets, enrichment resources and the
